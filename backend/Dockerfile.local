FROM langgenius/dify-api:1.5.1

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN /usr/local/bin/python3.12 -m pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app

ENV LUBAOBAO_UPLOAD_DIR=/data/uploads

EXPOSE 18080
ENTRYPOINT []
CMD ["/usr/local/bin/python3.12", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "18080"]
