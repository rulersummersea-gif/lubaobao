.status-tag { display:inline-block; flex-shrink:0; padding:8rpx 20rpx; border-radius:999rpx; font-size:24rpx; font-weight:600; white-space:nowrap; }
.status-normal { background:#dcfce7; color:#166534; }
.status-warning { background:#fef3c7; color:#92400e; }
.status-critical { background:#fee2e2; color:#991b1b; }
