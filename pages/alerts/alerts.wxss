@import '../../app.wxss';
.title-sm {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.alert-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.alert-btn {
  min-height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.25;
}

.alert-btn.primary {
  background: #1d4ed8;
  color: #fff;
}

.alert-btn.secondary {
  background: #e2e8f0;
  color: #0f172a;
}
