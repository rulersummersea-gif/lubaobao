<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="title">{{detail.boilerName}}</view>
    <view class="sub">{{detail.time}}</view>
    <view wx:if="{{detail.inspectorName}}" class="sub">检测人员：{{detail.inspectorName}}</view>
    <view class="sub">检测水样：{{detail.sampleTypeName}}</view>
    <view class="sub">{{detail.summary}}</view>
    <view wx:if="{{detail.ratedPressureMpa}}" class="sub">额定压力：{{detail.ratedPressureMpa}} MPa</view>
    <block wx:for="{{detail.standardWarnings}}" wx:key="*this">
      <view class="sub">标准提示：{{item}}</view>
    </block>
  </view>
  <view class="card">
    <view class="section-title">检测明细</view>
    <block wx:for="{{detail.items}}" wx:key="name">
      <view class="list-item row">
        <view>
          <view>{{item.priority}}. {{item.name}}</view>
          <view wx:if="{{item.method}}" class="sub">工具：{{item.method}}</view>
          <view wx:if="{{item.normalRange}}" class="sub">正常范围：{{item.normalRange}}</view>
          <view wx:if="{{item.pressureSegment}}" class="sub">适用压力段：{{item.pressureSegment}}</view>
          <view wx:if="{{item.standardSource}}" class="sub">依据：{{item.standardSource}}</view>
          <view wx:if="{{!item.standardMatched}}" class="sub">提示：{{item.standardNote}}</view>
          <view wx:if="{{item.meaning}}" class="sub">意义：{{item.meaning}}</view>
          <view wx:if="{{item.maintenance}}" class="sub">维护：{{item.maintenance}}</view>
        </view>
        <view style="text-align:right;">
          <view>{{item.value}}</view>
          <view class="sub">{{item.statusText}}</view>
        </view>
      </view>
    </block>
  </view>
  <view class="card">
    <view class="section-title">诊断建议</view>
    <block wx:for="{{detail.diagnosis}}" wx:key="title" wx:for-index="index">
      <view class="action-card">
        <view class="row action-head">
          <view>
            <view class="action-title">{{item.title}}</view>
            <view wx:if="{{item.riskType}}" class="action-risk">{{item.riskType}}</view>
          </view>
          <view class="copy-btn" data-index="{{index}}" bindtap="copyAction">复制</view>
        </view>
        <view wx:if="{{item.relatedItemNames}}" class="action-line">
          <view class="action-label">关联指标</view>
          <view class="action-text">{{item.relatedItemNames}}</view>
        </view>
        <view wx:if="{{item.reason}}" class="action-line">
          <view class="action-label">原因</view>
          <view class="action-text">{{item.reason}}</view>
        </view>
        <view wx:if="{{item.fieldAction}}" class="action-line action-primary">
          <view class="action-label">现场处置</view>
          <view class="action-text">{{item.fieldAction}}</view>
        </view>
        <view wx:if="{{item.retestPlan}}" class="action-line">
          <view class="action-label">复测要求</view>
          <view class="action-text">{{item.retestPlan}}</view>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{serviceTasks.length}}" class="card">
    <view class="section-title">服务处理意见</view>
    <block wx:for="{{serviceTasks}}" wx:key="id">
      <view class="service-task">
        <view class="service-task-title">{{item.title}}</view>
        <view wx:if="{{item.riskType}}" class="sub">{{item.riskType}}</view>
        <view wx:if="{{item.fieldAction}}" class="service-line">
          <view class="service-label">系统现场建议</view>
          <view class="service-text">{{item.fieldAction}}</view>
        </view>
        <view class="professional-advice {{item.serviceAdvice ? 'professional-advice-ready' : 'professional-advice-pending'}}">
          <view class="service-label">服务人员专业意见</view>
          <view class="service-text">
            {{item.serviceAdvice || '服务支持人员正在复核本次异常，专业处理意见将在这里更新。'}}
          </view>
          <view wx:if="{{item.serviceAdvice && item.serviceByName}}" class="service-meta">
            {{item.serviceByName}}{{item.serviceAtText ? '｜' + item.serviceAtText : ''}}
          </view>
        </view>
        <view wx:if="{{item.retestPlan}}" class="service-line">
          <view class="service-label">复测安排</view>
          <view class="service-text">{{item.retestPlan}}</view>
        </view>
      </view>
    </block>
  </view>
</view>
