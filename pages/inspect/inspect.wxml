<view class="container">
  <view class="card">
    <view class="title">发起巡检</view>
    <view wx:if="{{retestTask}}" class="tag tag-warn" style="margin-top:10rpx;">复测任务</view>
    <view wx:if="{{retestTask}}" class="sub">复测原因：{{retestTask.title}}</view>
    <view wx:if="{{retestTask.relatedItemNames}}" class="sub">复测项目：{{retestTask.relatedItemNames}}</view>
    <view class="sub">当前锅炉：{{retestTask ? retestTask.boilerName : (currentBoiler ? currentBoiler.name : '未选择')}}</view>
    <view wx:if="{{!retestTask}}" class="btn-secondary" bindtap="goChooseBoiler">选择锅炉</view>
    <view wx:if="{{retestTask}}" class="btn-secondary retest-cancel" bindtap="cancelRetest">取消本次复测</view>
  </view>

  <view class="card">
    <view class="title">检测准备</view>
    <view class="sub">材料包编码：{{materialPackCode || '未扫码'}}</view>
    <view wx:if="{{materialPackBoilerName}}" class="sub">绑定锅炉：{{materialPackBoilerName}}</view>
    <view class="btn-secondary" bindtap="scanPack">扫码材料包</view>
    <view style="height:16rpx"></view>
    <view class="btn-secondary" bindtap="useTestPack">使用测试包 PACK-001</view>
    <view style="height:16rpx"></view>
    <view class="btn-secondary" bindtap="chooseInspectionImage">{{previewImage ? '重新拍摄/选择照片' : '拍照/选择图片'}}</view>
    <view class="tip-box">请把软化水两项与炉水六项试纸统一放入操作台，一次完整拍摄。AI只读取试纸数值，检测判断由系统标准完成。</view>
    <view wx:if="{{previewImage}}" class="preview-box">
      <image class="preview-img" src="{{previewImage}}" mode="aspectFill"></image>
      <view class="btn-secondary quality-check-button {{qualityChecking ? 'button-disabled' : ''}}" bindtap="checkPhotoQuality">
        {{qualityChecking ? '正在检查照片' : (photoQuality ? '重新检查照片质量' : '检查照片质量')}}
      </view>
    </view>
    <view wx:if="{{photoQuality}}" class="quality-box quality-{{photoQuality.status}}">
      <view class="quality-title">
        照片质量：{{photoQuality.status === 'pass' ? '合格' : photoQuality.status === 'review' ? '建议复核' : '不合格'}}
      </view>
      <view class="quality-score">{{photoQuality.score}}分</view>
      <view class="quality-summary">{{photoQuality.summary}}</view>
      <view wx:if="{{photoQuality.width}}" class="quality-metrics">
        {{photoQuality.width}}×{{photoQuality.height}}像素｜亮度 {{photoQuality.brightness}}｜对比度 {{photoQuality.contrast}}｜清晰度 {{photoQuality.sharpness}}
      </view>
      <block wx:for="{{photoQuality.flags}}" wx:key="code">
        <view class="quality-issue quality-issue-{{item.severity}}">{{item.message}}</view>
      </block>
      <view wx:if="{{!photoQuality.canProceed}}" class="btn-primary retake-button" bindtap="chooseInspectionImage">重新拍摄</view>
    </view>
  </view>

  <view class="card">
    <view class="title">试纸识别读数</view>
    <view class="sub">灰测阶段请核对并填写AI读取的数值，系统会分别判断软化水和炉水结果。</view>
    <block wx:for="{{waterItems}}" wx:key="code" wx:for-index="index">
      <view wx:if="{{item.showGroupTitle}}" class="water-group-title">{{item.groupName}}</view>
      <view class="water-input-row">
        <view>
          <view class="water-name">{{item.name}}</view>
          <view class="sub">{{item.unit || '无单位'}}</view>
        </view>
        <input class="water-input" type="digit" value="{{item.value}}" placeholder="{{item.placeholder}}" data-index="{{index}}" bindinput="onWaterValueInput" />
      </view>
    </block>
  </view>

  <view class="card">
    <view class="btn-primary {{submitting || qualityChecking || (photoQuality && !photoQuality.canProceed) ? 'button-disabled' : ''}}" bindtap="startInspection">
      {{submitting ? '提交中' : qualityChecking ? '正在检查照片' : (photoQuality && !photoQuality.canProceed) ? '请先重新拍摄' : (retestTask ? '提交复测' : '开始巡检')}}
    </view>
  </view>
</view>
