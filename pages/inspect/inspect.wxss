@import '../../app.wxss';

.preview-box { margin-top: 24rpx; }
.preview-img {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
}

.tip-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
  border-radius: 16rpx;
  color: #1e3a8a;
  font-size: 28rpx;
  line-height: 1.6;
}

.water-input-row {
  display: grid;
  grid-template-columns: 1fr 220rpx;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #dbe3ef;
}

.water-input-row:last-child {
  border-bottom: none;
}

.water-name {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.water-input {
  width: 100%;
  min-height: 92rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}
