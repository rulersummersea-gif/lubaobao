<view class="container" wx:if="{{result}}">
  <view class="card">
    <view class="row">
      <view class="title">巡检结果</view>
      <view class="tag {{result.riskClass}}">{{result.riskLabel}}</view>
    </view>
    <view wx:if="{{result.summary}}" class="sub" style="margin-top:12rpx;">{{result.summary}}</view>
    <view wx:if="{{result.ratedPressureMpa}}" class="sub">额定压力：{{result.ratedPressureMpa}} MPa</view>
    <block wx:for="{{result.standardWarnings}}" wx:key="*this">
      <view class="sub">标准提示：{{item}}</view>
    </block>
  </view>
  <view class="card">
    <view class="section-title">检测值</view>
    <block wx:for="{{result.items}}" wx:key="name">
      <view class="list-item row">
        <view>
          <view>{{item.priority}}. {{item.name}}</view>
          <view wx:if="{{item.method}}" class="sub">工具：{{item.method}}</view>
          <view wx:if="{{item.normalRange}}" class="sub">正常范围：{{item.normalRange}}</view>
          <view wx:if="{{item.pressureSegment}}" class="sub">适用压力段：{{item.pressureSegment}}</view>
          <view wx:if="{{item.standardSource}}" class="sub">依据：{{item.standardSource}}</view>
          <view wx:if="{{!item.standardMatched}}" class="sub">提示：{{item.standardNote}}</view>
          <view wx:if="{{item.meaning}}" class="sub">意义：{{item.meaning}}</view>
          <view wx:if="{{item.maintenance}}" class="sub">维护：{{item.maintenance}}</view>
        </view>
        <view style="text-align:right;">
          <view>{{item.value}}</view>
          <view class="sub">{{item.statusText}}</view>
        </view>
      </view>
    </block>
  </view>
  <view class="card">
    <view class="section-title">智能诊断</view>
    <block wx:for="{{result.diagnosis}}" wx:key="title">
      <view class="list-item">
        <view>{{item.title}}</view>
        <view wx:if="{{item.riskType}}" class="sub">风险：{{item.riskType}}</view>
        <view wx:if="{{item.relatedItemNames}}" class="sub">关联指标：{{item.relatedItemNames}}</view>
        <view wx:if="{{item.reason}}" class="sub">原因：{{item.reason}}</view>
        <view wx:if="{{item.advice}}" class="sub">建议：{{item.advice}}</view>
      </view>
    </block>
  </view>
  <view class="btn-primary" bindtap="submitRecord">查看巡检记录</view>
</view>
